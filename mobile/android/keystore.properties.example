# Copy to keystore.properties (same folder) and fill in. Both that file and the
# .jks it points to are git-ignored. Create a key with:
#   keytool -genkeypair -v -keystore ../keystore/moneytabs.jks -alias moneytabs -keyalg RSA -keysize 2048 -validity 10000
storeFile=../keystore/moneytabs.jks
storePassword=CHANGE_ME
keyAlias=moneytabs
keyPassword=CHANGE_ME
